{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "BETTER_AUTH_SECRET", "API_URL", "APP_URL"],
  "globalPassThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".open-next/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": false
    },
    "lint": {},
    "deploy": { "cache": false },
    "db:generate": { "cache": false }
  }
}
