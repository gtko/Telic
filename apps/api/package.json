{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*.ts",
    "#mcp/*": "./src/mcp/*.ts",
    "#modules/*": "./src/modules/*.ts",
    "#tests/*": "./src/__tests__/*.ts"
  },
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply telic --local",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:d1": "vitest run",
    "gen:changelog": "node scripts/gen-changelog.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply telic --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.92",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@mastra/cloudflare-d1": "1.4.4",
    "@mastra/core": "^1.78.0",
    "@mastra/memory": "^1.38.0",
    "@mastra/observability": "^1.20.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@repo/agent-tools": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/cron": "workspace:*",
    "@repo/crypto": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/mailer": "workspace:*",
    "@repo/net": "workspace:*",
    "@repo/storage": "workspace:*",
    "@tiptap/pm": "3.32.0",
    "decode-named-character-reference": "^1.3.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "transliteration": "^2.6.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@elysiajs/eden": "^1.4.9",
    "@repo/eslint-config": "workspace:*",
    "@types/bun": "latest",
    "eslint": "^9.39.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
