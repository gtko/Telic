{
  // The API Worker (ODY-296). `wrangler dev --local` serves it from Miniflare (local D1 and R2,
  // persisted under .wrangler/state): it never contacts Cloudflare. The D1 database and R2 bucket
  // below exist in the Gtux account (telic, telic-attachments).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telic-api",
  "account_id": "4f2452fbc81b70c2549d6f7dd779b190",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat: better-auth and the MCP SDK use node:crypto, node:buffer and
  // node:stream. It also exposes process.env, filled from the vars and secrets below.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telic",
      "database_id": "2f751597-4754-4e74-b4a7-3c07ccaeedc3",
      // The single baseline of packages/db: `wrangler d1 migrations apply DB --local|--remote`.
      "migrations_dir": "../../packages/db/drizzle-d1",
    },
  ],

  // Attachments and avatars.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "telic-attachments" }],

  // `scheduled()` tells the triggers apart by these exact expressions (CRON_* in src/scheduled.ts).
  "triggers": {
    "crons": [
      "0 * * * *", // issue auto-archive and SCIM reconcile
    ],
  },

  // Public variables. APP_URL is the web origin (comma-separated for several) and API_URL this
  // Worker's public origin. Replace both when the Workers move to a custom domain. The web and the
  // API are two subdomains of the same workers.dev account, so the session cookie is shared through
  // the parent domain. Optional, see src/env.ts: COOKIE_DOMAIN, PASSKEY_RP_ID, PASSKEY_RP_NAME,
  // CLIENT_IP_HEADER, TRUSTED_PROXIES, SSRF_ALLOWED_HOSTS, EMAIL_FROM, NOTIFICATIONS_EMAIL_FROM,
  // GIT_WEBHOOK_BASE_URL. Never put a secret here.
  "vars": {
    "APP_URL": "https://telic-web.gtux-prog.workers.dev",
    "API_URL": "https://telic-api.gtux-prog.workers.dev",
  },
  "upload_source_maps": false,

  // Secrets, never in this file. Production: `wrangler secret put <NAME>`; local: copy
  // .dev.vars.example to .dev.vars (git-ignored).
  //   BETTER_AUTH_SECRET  required, signs sessions and tokens, 32+ random characters
  //   APP_ENCRYPTION_KEY  required, 32 bytes base64, encrypts the stored credentials; the same
  //                       value goes on telic-worker and telic-bot
  // The Resend/SMTP and Telegram bot credentials are saved in the instance settings, encrypted
  // with APP_ENCRYPTION_KEY, not set as Worker secrets. TELEGRAM_WEBHOOK_SECRET is a secret of
  // telic-bot only.
}
