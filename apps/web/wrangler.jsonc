{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telic-web",
  "account_id": "4f2452fbc81b70c2549d6f7dd779b190",
  "main": ".open-next/worker.js",
  // Recent enough for nodejs_compat to populate process.env from `vars` and secrets,
  // which is how utils/runtimeEnv reads API_URL, PRIVACY_URL and TERMS_URL.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  // API_URL is the public origin of telic-api; PRIVACY_URL and TERMS_URL are optional. Local
  // preview reads them from .dev.vars (see .dev.vars.example).
  "vars": {
    "API_URL": "https://telic-api.gtux-prog.workers.dev",
  },
  "upload_source_maps": false,
  // keep_names makes esbuild inject __name(), which breaks the inline theme script of next-themes.
  "keep_names": false,
}
