{
  "name": "itsaplan",
  "version": "1.8.0",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@repo/eslint-config": "workspace:*",
    "@types/bun": "^1.4.3",
    "eslint": "^9.39.0",
    "lefthook": "^2.2.2",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.3",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=!@repo/desktop",
    "build": "turbo run build --filter=!@repo/desktop",
    "lint": "turbo run lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "test": "bun test scripts/ && turbo run test --concurrency=1",
    "db:generate": "bun --filter='@repo/db' run db:generate",
    "auth:generate": "bun --filter='@repo/auth' run auth:generate",
    "prepare": "lefthook install || true",
    "db:migrate:local": "bun --filter='api' run db:migrate:local",
    "db:migrate:remote": "bun --filter='api' run db:migrate:remote",
    "deploy": "turbo run deploy --concurrency=1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@scalar/types": "0.16.2",
    "@scalar/themes": "0.16.2"
  }
}
